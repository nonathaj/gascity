#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 3 ]]; then
  echo "usage: $0 <package> <shard-index> <shard-total>" >&2
  exit 1
fi

test_pkg="$1"
shard_index="$2"
shard_total="$3"

if ! [[ "$shard_index" =~ ^[0-9]+$ && "$shard_total" =~ ^[0-9]+$ ]]; then
  echo "shard index and total must be positive integers" >&2
  exit 1
fi
if (( shard_index < 1 || shard_total < 1 || shard_index > shard_total )); then
  echo "invalid shard ${shard_index} of ${shard_total}" >&2
  exit 1
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
source "$repo_root/scripts/lib/common.sh"
# shellcheck source=lib/test-slice.sh
source "$repo_root/scripts/lib/test-slice.sh"
gc_test_slice_reexec "$repo_root/scripts/test-go-test-shard" "$@"

timeout="${GO_TEST_TIMEOUT:-20m}"

gopath_val="$(go env GOPATH)"
gocache_val="$(go env GOCACHE)"
gomodcache_val="$(go env GOMODCACHE)"
gotmpdir_val="$(go env GOTMPDIR)"
goroot_val="$(go env GOROOT)"

# Mirror the Makefile's CGO path detection here so tests run via this script
# see the same system dependency paths as `make`. When invoked from
# test-integration-shard, CGO_CPPFLAGS/CGO_LDFLAGS may already be set by that
# script; the helper avoids double-adding duplicate words.
cgo_cppflags="${CGO_CPPFLAGS:-}"
cgo_ldflags="${CGO_LDFLAGS:-}"
configure_cgo_platform_paths

extra_env=()
while IFS='=' read -r name _; do
  case "$name" in
    ANTHROPIC_*|CLAUDE_CODE_*|GC_ACCEPTANCE_KEEP|GC_TIERC_FORCE|GC_TUTORIAL_GOLDENS_USE_CLAUDE_FOR_CODEX)
      extra_env+=("${name}=${!name}")
      ;;
  esac
done < <(env)

run_in_test_env() {
  local base_env=(
    PATH="${PATH}" \
    HOME="${HOME:-}" \
    USER="${USER:-}" \
    LOGNAME="${LOGNAME:-}" \
    SHELL="${SHELL:-/bin/sh}" \
    LANG="${LANG:-C.UTF-8}" \
    TMPDIR="${TMPDIR:-/var/tmp}" \
    TMP="${TMP-}" \
    TEMP="${TEMP-}" \
    SYSTEMROOT="${SYSTEMROOT-}" \
    SYSTEMDRIVE="${SYSTEMDRIVE-}" \
    WINDIR="${WINDIR-}" \
    COMSPEC="${COMSPEC-}" \
    PATHEXT="${PATHEXT-}" \
    USERPROFILE="${USERPROFILE-}" \
    LOCALAPPDATA="${LOCALAPPDATA-}" \
    APPDATA="${APPDATA-}" \
    ProgramData="${ProgramData-}" \
    NUMBER_OF_PROCESSORS="${NUMBER_OF_PROCESSORS-}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    GOPATH="${gopath_val}" \
    GOCACHE="${gocache_val}" \
    GOMODCACHE="${gomodcache_val}" \
    GOTMPDIR="${gotmpdir_val}" \
    GOROOT="${GOROOT:-$goroot_val}" \
    GOENV="${GOENV-}" \
    GOFLAGS="${GOFLAGS-}" \
    GO111MODULE="${GO111MODULE-}" \
    GOEXPERIMENT="${GOEXPERIMENT-}" \
    GOPROXY="${GOPROXY-}" \
    GOPRIVATE="${GOPRIVATE-}" \
    GONOPROXY="${GONOPROXY-}" \
    GONOSUMDB="${GONOSUMDB-}" \
    GOSUMDB="${GOSUMDB-}" \
    GOINSECURE="${GOINSECURE-}" \
    GOVCS="${GOVCS-}" \
    GOWORK="${GOWORK-}" \
    GC_FAST_UNIT="${GC_FAST_UNIT:-0}" \
    CGO_CPPFLAGS="${cgo_cppflags}" \
    CGO_LDFLAGS="${cgo_ldflags}" \
    GC_TEST_SHARD_INDEX="${shard_index}" \
    GC_TEST_SHARD_TOTAL="${shard_total}"
  )
  if (( ${#extra_env[@]} > 0 )); then
    env -i "${base_env[@]}" "${extra_env[@]}" "$@"
  else
    env -i "${base_env[@]}" "$@"
  fi
}

run_go_test() {
  run_in_test_env go test "$@"
}

run_observable_go_test() {
  local timing_name="${GO_TEST_TIMING_NAME:-${test_pkg#./}-shard-${shard_index}-of-${shard_total}}"
  local observable_env=(
    OBSERVABLE_TIMING_FILE="${GO_TEST_TIMING_FILE}"
    OBSERVABLE_SHARD_ID="${timing_name}"
    OBSERVABLE_VARIANT="${GO_TEST_TIMING_VARIANT:-default}"
    OBSERVABLE_COMMIT_SHA="${GITHUB_SHA:-}"
    OBSERVABLE_WORKFLOW="${GITHUB_WORKFLOW:-}"
    OBSERVABLE_RUN_ID="${GITHUB_RUN_ID:-}"
    OBSERVABLE_RUN_ATTEMPT="${GITHUB_RUN_ATTEMPT:-}"
    OBSERVABLE_JOB="${GITHUB_JOB:-}"
    OBSERVABLE_RUNNER_LABEL="${GO_TEST_RUNNER_LABEL:-}"
    OBSERVABLE_RUNNER_NAME="${RUNNER_NAME:-}"
    OBSERVABLE_RUNNER_OS="${RUNNER_OS:-}"
    OBSERVABLE_RUNNER_ARCH="${RUNNER_ARCH:-}"
    OBSERVABLE_RUNNER_CPU_COUNT="${GO_TEST_RUNNER_CPU_COUNT:-}"
  )
  if [[ "${GC_TEST_NO_SLICE:-0}" == "1" ]]; then
    observable_env+=(GC_TEST_NO_SLICE=1)
  fi
  run_in_test_env "${observable_env[@]}" \
    "$repo_root/scripts/go-test-observable" "$timing_name" -- "$@"
}

go_test_args=(-timeout "$timeout")
if [[ -n "${GO_TEST_TAGS:-}" ]]; then
  go_test_args=(-tags "$GO_TEST_TAGS" "${go_test_args[@]}")
fi
if [[ -n "${GO_TEST_COUNT:-}" ]]; then
  go_test_args=(-count="$GO_TEST_COUNT" "${go_test_args[@]}")
fi
if [[ -n "${GO_TEST_COVERPROFILE:-}" ]]; then
  go_test_args+=(-coverpkg=./... -coverprofile "$GO_TEST_COVERPROFILE")
fi

tests=()
if [[ ${GO_TEST_MANIFEST+x} == x ]]; then
  if [[ ! -f "$GO_TEST_MANIFEST" || ! -r "$GO_TEST_MANIFEST" ]]; then
    echo "go test manifest is not readable: ${GO_TEST_MANIFEST}" >&2
    exit 1
  fi
  if ! LC_ALL=C tr -d '\000' < "$GO_TEST_MANIFEST" | cmp -s "$GO_TEST_MANIFEST" -; then
    echo "go test manifest contains NUL bytes or could not be validated: ${GO_TEST_MANIFEST}" >&2
    exit 1
  fi

  line_number=0
  manifest_test_count=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_number=$((line_number + 1))
    if [[ "$line" =~ ^[[:space:]]*$ || "$line" =~ ^[[:space:]]*# ]]; then
      continue
    fi
    if ! [[ "$line" =~ ^Test$ || "$line" =~ ^Test[A-Z0-9_][A-Za-z0-9_]*$ ]]; then
      echo "invalid go test manifest entry in ${GO_TEST_MANIFEST} at line ${line_number}: ${line}" >&2
      exit 1
    fi
    if (( manifest_test_count > 0 )); then
      for existing in "${tests[@]}"; do
        if [[ "$existing" == "$line" ]]; then
          echo "duplicate go test manifest entry: ${line}" >&2
          exit 1
        fi
      done
    fi
    tests+=("$line")
    manifest_test_count=$((manifest_test_count + 1))
  done < "$GO_TEST_MANIFEST"

  if (( manifest_test_count == 0 )); then
    echo "go test manifest contains no tests: ${GO_TEST_MANIFEST}" >&2
    exit 1
  fi
else
  # Capture the enumeration separately so a build/compile failure here surfaces
  # its output. `go test -list` builds the test binary; if that fails, the bare
  # assignment's non-zero status is swallowed by `set -e` (the script dies before
  # the "no tests discovered" branch below), producing an undebuggable empty
  # shard failure. Check the status explicitly and print what go printed.
  if ! list_output="$(run_go_test "${go_test_args[@]}" "$test_pkg" -list '^Test' 2>&1)"; then
    echo "go test -list failed for ${test_pkg} (build/compile error); output:" >&2
    printf '%s\n' "$list_output" >&2
    exit 1
  fi
  while IFS= read -r line; do
    [[ "$line" == Test* ]] || continue
    tests+=("$line")
  done <<< "$list_output"

  if [[ ${#tests[@]} -eq 0 ]]; then
    echo "no tests discovered for ${test_pkg}; go test -list output:" >&2
    printf '%s\n' "$list_output" >&2
    exit 1
  fi
fi

selected=()
for i in "${!tests[@]}"; do
  if (( i % shard_total == shard_index - 1 )); then
    selected+=("${tests[$i]}")
  fi
done

if [[ ${#selected[@]} -eq 0 ]]; then
  echo "no tests selected for ${test_pkg} shard ${shard_index} of ${shard_total}" >&2
  exit 1
fi

join_regex() {
  local IFS='|'
  printf '%s' "$*"
}

# Maximum characters to spend on a single -run regex.
#
# Windows caps an entire CreateProcess command line at 32767 characters, and a
# cmd/gc shard blows straight through it: ~8200 tests over 6 shards is ~1400
# names per shard, which joins into a ~60 KB alternation and fails with
# "env: 'go': Argument list too long" before a single test runs. Unix has no
# comparable limit in practice (ARG_MAX is ~2 MB), so the budget only ever
# binds on Windows; the batching below is a no-op elsewhere because a whole
# shard fits in one batch.
#
# 28000 leaves room for the rest of the command line -- the go binary path, the
# package, the flags, and the full environment env(1) rebuilds, all of which
# count against the same limit.
#
# The default is 0 (unlimited, one batch) everywhere except Windows. This is
# deliberately NOT a uniform budget: a cmd/gc shard's regex measures ~68000
# characters, so a cross-platform 28000 would silently split Linux shards into
# three invocations too -- changing which tests share a process, tripling the
# effective -timeout, and (worst) making each batch overwrite the previous
# batch's -coverprofile. Unix has no argv limit worth working around here, so it
# keeps the exact single-invocation behavior it always had.
case "$(uname -s 2>/dev/null || echo unknown)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT) _default_regex_budget=28000 ;;
  *)                               _default_regex_budget=0 ;;
esac
GO_TEST_RUN_REGEX_BUDGET="${GO_TEST_RUN_REGEX_BUDGET:-$_default_regex_budget}"

# Split the shard into batches whose -run regex fits the budget. Batching keeps
# the shard's test SET identical -- every selected test still runs exactly once,
# in this shard -- so cross-shard parallelism and coverage are unchanged; only
# the number of `go test` invocations grows.
batches=()
current=()
current_len=0
for name in "${selected[@]}"; do
  # +1 for the '|' separator this name will need.
  name_len=$(( ${#name} + 1 ))
  if (( GO_TEST_RUN_REGEX_BUDGET > 0 && ${#current[@]} > 0 && current_len + name_len > GO_TEST_RUN_REGEX_BUDGET )); then
    batches+=("$(join_regex "${current[@]}")")
    current=()
    current_len=0
  fi
  current+=("$name")
  current_len=$(( current_len + name_len ))
done
if (( ${#current[@]} > 0 )); then
  batches+=("$(join_regex "${current[@]}")")
fi

echo "Running ${test_pkg} shard ${shard_index} of ${shard_total} (${#selected[@]} tests)"
printf '  %s\n' "${selected[@]}"
if (( ${#batches[@]} > 1 )); then
  echo "  (split into ${#batches[@]} batches to stay under the ${GO_TEST_RUN_REGEX_BUDGET}-char -run regex budget)"
fi

# Run every batch even after one fails, then report the first failure. Stopping
# at the first failing batch would hide the rest of the shard's results and make
# a batched run report strictly less than an unbatched run of the same shard.
#
# Coverage needs care once there is more than one batch: `go test -coverprofile`
# TRUNCATES its output file, so reusing one path across batches would leave only
# the last batch's profile and silently under-report the shard. Each batch writes
# its own profile and they are merged below.
shard_status=0
batch_profiles=()
batch_number=0
for batch in "${batches[@]}"; do
  batch_number=$(( batch_number + 1 ))
  regex="^(${batch})\$"
  batch_args=("${go_test_args[@]}")
  if [[ -n "${GO_TEST_COVERPROFILE:-}" && ${#batches[@]} -gt 1 ]]; then
    batch_profile="${GO_TEST_COVERPROFILE}.batch${batch_number}"
    batch_profiles+=("$batch_profile")
    # Replace the -coverprofile argument's value with this batch's path.
    for (( i = 0; i < ${#batch_args[@]}; i++ )); do
      if [[ "${batch_args[$i]}" == "-coverprofile" ]]; then
        batch_args[$((i + 1))]="$batch_profile"
        break
      fi
    done
  fi
  if [[ -n "${GO_TEST_TIMING_FILE:-}" ]]; then
    run_observable_go_test "${batch_args[@]}" "$test_pkg" -run "$regex" || shard_status=$?
  else
    run_go_test "${batch_args[@]}" "$test_pkg" -run "$regex" || shard_status=$?
  fi
done

# Merge per-batch profiles into the path the caller asked for. Every batch runs
# the same package set with the same -covermode, so a valid merge is the single
# shared "mode:" header followed by every batch's data lines.
if (( ${#batch_profiles[@]} > 0 )); then
  merged_mode=""
  : > "$GO_TEST_COVERPROFILE"
  for batch_profile in "${batch_profiles[@]}"; do
    [[ -f "$batch_profile" ]] || continue
    if [[ -z "$merged_mode" ]]; then
      merged_mode="$(head -n 1 "$batch_profile")"
      printf '%s\n' "$merged_mode" >> "$GO_TEST_COVERPROFILE"
    fi
    tail -n +2 "$batch_profile" >> "$GO_TEST_COVERPROFILE"
    rm -f "$batch_profile"
  done
fi
exit "$shard_status"
